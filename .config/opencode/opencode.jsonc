{
  "$schema": "https://opencode.ai/config.json",
  "theme": "catppuccin",
  "model": "evroc/moonshotai/Kimi-K2.6",
  "plugin": ["oh-my-openagent@3.13.1"],
  "permission": {
    "read": {
      "/tmp/**": "allow"
    },
    "edit": {
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git config *": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git add*": "deny",
      "git rm*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git stash*": "deny",
      "git tag*": "deny",
      "git mv*": "deny",
      "rm": "deny",
      "rm *": "ask",
      "rm -rf *": "deny"
    }
  },
  "provider": {
    "evroc": {
      "name": "evroc",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://models.think.cloud.evroc.com/v1",
        "headers": {
          "Authorization": "Bearer {env:THINK_API_KEY}"
        }
      },
      "models": {
        "moonshotai/Kimi-K2.6": {
          "name": "moonshotai/Kimi-K2.6",
          // "limit": {
          //   "context": 262000,
          //   "output": 56000
          // }
        },
        "moonshotai/Kimi-K2.5": {
          "name": "moonshotai/Kimi-K2.5",
          "limit": {
            "context": 262000,
            "output": 56000
          }
        },
        "Qwen/Qwen3.6-35B-A3B-FP8": {
          "name": "Qwen/Qwen3.6-35B-A3B-FP8",
          "limit": {
            "context": 440000,
            "output": 20000
          }
        },
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b",
          "limit": {
            "context": 40000,
            "output": 25000
          }
        },
        "microsoft/Phi-4-multimodal-instruct": {
          "name": "microsoft/Phi-4-multimodal-instruct",
          "limit": {
            "context": 20000,
            "output": 10000
          }
        },
        "moonshotai/Kimi-K2-Thinking": {
          "name": "moonshotai/Kimi-K2-Thinking",
          "limit": {
            "context": 100000,
            "output": 50000
          }
        },
        "mistralai/Devstral-Small-2-24B-Instruct": {
          "name": "mistralai/Devstral-Small-2-24B-Instruct",
          "limit": {
            "context": 10000,
            "output": 10000
          }
        },
        "mistralai/Magistral-Small-2509": {
          "name": "mistralai/Magistral-Small-2509",
          "limit": {
            "context": 10000,
            "output": 10000
          }
        },
        "mistralai/Voxtral-Small-24B-2507": {
          "name": "mistralai/Voxtral-Small-24B-2507",
          "limit": {
            "context": 32000,
            "output": 32000
          }
        },
        "nvidia/Llama-3.3-70B-Instruct-FP8": {
          "name": "nvidia/Llama-3.3-70B-Instruct-FP8",
          "limit": {
            "context": 128000,
            "output": 4000
          }
        },
        "zai-org/GLM-5.2": {
          "name": "zai-org/GLM-5.2",
          "limit": {
            "context": 524000,
            "output": 131000
          }
        },
        "google/gemma-4-26B-A4B-it": {
          "name": "google/gemma-4-26B-A4B-it",
          "limit": {
            "context": 262000,
            "output": 33000
          }
        },
        "mistralai/Mistral-Medium-3.5-128B": {
          "name": "mistralai/Mistral-Medium-3.5-128B",
          "limit": {
            "context": 262000,
            "output": 262000
          }
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen/Qwen3.6-35B-A3B",
          "limit": {
            "context": 262000,
            "output": 66000
          }
        },
        "Qwen/Qwen3.8-27B": {
          "name": "Qwen/Qwen3.8-27B",
          "limit": {
            "context": 262000,
            "output": 262000
          }
        },
        "evroc/roc": {
          "name": "evroc/roc",
          "limit": {
            "context": 262000,
            "output": 262000
          }
        },
        "intfloat/multilingual-e5-large-instruct": {
          "name": "intfloat/multilingual-e5-large-instruct",
          "limit": {
            "context": 512,
            "output": 512
          }
        },
        "Qwen/Qwen3-Embedding-8B": {
          "name": "Qwen/Qwen3-Embedding-8B",
          "limit": {
            "context": 41000,
            "output": 4000
          }
        },
        "Qwen/Qwen3-Reranker-4B": {
          "name": "Qwen/Qwen3-Reranker-4B",
          "limit": {
            "context": 32000,
            "output": 4000
          }
        },
        "KBLab/kb-whisper-large": {
          "name": "KBLab/kb-whisper-large",
          "limit": {
            "context": 448,
            "output": 448
          }
        },
        "openai/whisper-large-v3": {
          "name": "openai/whisper-large-v3",
          "limit": {
            "context": 448,
            "output": 4000
          }
        },
        "openai/whisper-large-v3-turbo": {
          "name": "openai/whisper-large-v3-turbo",
          "limit": {
            "context": 448,
            "output": 448
          }
        }
      }
    }
  }
}
